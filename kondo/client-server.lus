include "common.lus"

const N: Pos = 2; -- Number of participants
type HostId = subtype { i : Nat | i < N };

-- {{{ Message Types

type MessageType = enum { Request, Response };

type Message = struct {
  msg_type: MessageType;
  sender: HostId;
  dest: HostId;
};

type MsgSet = struct {
  requests: bool^N^N;
  responses: bool^N^N;
};

const EmptySet: MsgSet = MsgSet {
  responses =  false^N^N;
  requests = false^N^N;
};

function MkResponse(src: HostId; dest: HostId) returns (msg: Message)
let
  msg = Message {
      msg_type = Response;
      sender = src;
      dest = dest;
  };
tel

function MkRequest(src: HostId; dest: HostId) returns (msg: Message)
let
  msg = Message {
      msg_type = Request;
      sender = src;
      dest = dest;
  };
tel


function None (arr: bool^N) returns (none: bool);
var n : bool^N;
let
  n[i] = if i = 0 then not arr[i] else n[i-1] and not arr[i];
  none = n[N-1];
tel

function All (arr: bool^N) returns (all: bool);
var a : bool^N;
let
  a[i] = if i = 0 then arr[i] else a[i-1] and arr[i];
  all = a[N-1];
tel

function EmptyMessageArray (arr: bool^N^N) returns (empty: bool);
var a: bool^N;
let
  a[i] = None(arr[i]);
  empty = All(a);
tel

function IsEmpty (msg_set: MsgSet) returns (empty: bool);
let
  empty =
    EmptyMessageArray(msg_set.responses) and
    EmptyMessageArray(msg_set.requests);
tel


function SetMsg(svm_in: bool^N^N; msg: Message) returns (svm_out: bool^N^N);
let
  svm_out[i][j] =
    if i = msg.sender and j = msg.dest then
      true
    else
      svm_in[i][j];
tel

function AddMsg(svm_in: MsgSet; msg: Message) returns (svm_out: MsgSet);
(* @contract
  guarantee "Message is added"
  MsgInSet(svm_out, msg);
*)
let
  svm_out = MsgSet {
    responses =
      if msg.msg_type = Response
        then SetMsg(svm_in.responses, msg)
      else
        svm_in.responses;

    requests =
      if msg.msg_type = Request
        then SetMsg(svm_in.requests, msg)
      else
        svm_in.requests;
  };
tel

function UnsetMsg(svm_in: bool^N^N; msg: Message) returns (svm_out: bool^N^N);
(* @contract
  guarantee "Message is removed"
  not MsgInSet(svm_out, msg);
*)
let
  svm_out[i][j] =
    if i = msg.sender and j = msg.dest then
      false
    else
      svm_in[i][j];
tel

function RemoveMsg(svm_in: MsgSet; msg: Message) returns (svm_out: MsgSet);
let
  svm_out = MsgSet {
    responses =
      if msg.msg_type = Response
        then UnsetMsg(svm_in.responses, msg)
      else
        svm_in.responses;

    requests =
      if msg.msg_type = Request
        then UnsetMsg(svm_in.requests, msg)
      else
        svm_in.requests;
  };
tel

function MsgInSet(svm: MsgSet; msg: Message) returns (contained: bool);
let
  contained =
    if msg.msg_type = Request then
      svm.requests[msg.sender][msg.dest]
    else
      svm.responses[msg.sender][msg.dest];
tel
-- }}}

-- {{{ Network
node Network(turn: HostId; send: Option<<Message>>) returns
  (recv: Option<<Message>>; inFlight: MsgSet);
(*@contract

  assume "Sends come from turn"
    send.some =>
      send.value.sender = turn;

  assume "No one sends to self"
    send.some =>
      send.value.dest <> send.value.sender;

  guarantee "Recv goes to turn"
  recv.some =>
    recv.value.dest = turn;

  guarantee "Recieved messages are in flight"
    recv.some =>
      (false -> MsgInSet(pre inFlight, recv.value));

  guarantee "Recieved messages are not in flight"
    recv.some =>
      not MsgInSet(inFlight, recv.value);

  guarantee "Sent messages are in flight"
    send.some =>
      MsgInSet(inFlight, send.value);

  guarantee "Messages are not in flight unless sent"
    forall (msg : Message)
      (
       (true -> not MsgInSet(pre inFlight, msg)) and
       MsgInSet(inFlight, msg)
      ) =>
      (send.some and send.value = msg);

  guarantee "Messages stay in flight until recieved"
    forall (msg : Message)
      (
       (false -> MsgInSet(pre inFlight, msg)) and
       not MsgInSet(inFlight, msg)
      ) =>
      (recv.some and recv.value = msg);

*)
var prevInFlight: MsgSet;
let
  prevInFlight = EmptySet -> pre inFlight;

  recv = any {
      m: Option<<Message>> |
      m.some =>
        ( MsgInSet(prevInFlight, m.value) and
          m.value.dest = turn
        )
    };

  inFlight =
    if send.some and recv.some then
      AddMsg(RemoveMsg(prevInFlight, recv.value), send.value)
    else if send.some then
      AddMsg(prevInFlight, send.value)
    else if recv.some then
      RemoveMsg(prevInFlight, recv.value)
    else
      prevInFlight;
tel
-- }}}


-- {{{ Participant
node Participant(id: HostId; nw_recv: Option<<Message>>)
  returns (nw_send: Option<<Message>>; current_requests: Option<<HostId>>^N; valid_response: bool);
(*@contract

  assume "No requests from self"
    nw_recv.some =>
      nw_recv.value.sender <> nw_recv.value.dest;

  guarantee "Do not send to self"
    nw_send.some
      => nw_send.value.dest <> nw_send.value.sender;

  guarantee "Frame"
    true ->
      (forall (hid: HostId)
        hid <> id =>
          current_requests[hid] = pre current_requests[hid]
      );

  guarantee "Requests changing implies message processing"
    true ->
      (forall (hid: HostId)
          (current_requests[hid] <> pre current_requests[hid]) =>
          (nw_recv.some or nw_send.some)
      );

  guarantee "Correct Sender"
    nw_send.some =>
      nw_send.value.sender = id;

  guarantee "Response implies request"
    (nw_send.some and nw_send.value.msg_type = Response) =>
    (nw_recv.some and nw_recv.value.msg_type = Request);

*)
var recieving, requesting, responding: bool;
var requesting_from: HostId;
var prev_current_requests: Option<<HostId>>^N;
let

  prev_current_requests[i] = OptNone<<HostId>>() -> pre current_requests[i];

  requesting_from = any { hid: HostId | hid <> id };

  recieving =
    nw_recv.some and
    nw_recv.value.dest = id;

  valid_response =
    recieving and
    nw_recv.value.msg_type = Response and
    prev_current_requests[id].some and
    prev_current_requests[id].value = nw_recv.value.sender;

  responding =
    recieving and
    nw_recv.value.msg_type = Request;

  requesting =
    not prev_current_requests[id].some and -- We should not be waiting on a request
    not responding and                     -- We should not be responding to a request
    any bool;                              -- We may choose to make a request

  nw_send =
    if responding then
      OptSome<<Message>>(MkResponse(id, nw_recv.value.sender))
    else if requesting then
      OptSome<<Message>>(MkRequest(id, requesting_from))
    else
      OptNone<<Message>>();

  current_requests[i] =
    if i <> id then
      prev_current_requests[i]
    else if valid_response then
      OptNone<<HostId>>()
    else if requesting then
      OptSome<<HostId>>(requesting_from)
    else
      prev_current_requests[i];


tel
-- }}}
