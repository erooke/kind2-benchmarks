type Nat = subrange [0,*] of int;
type Pos = subrange [1,*] of int;

type Option<T> = struct {
  some: bool;
  value: T;
};

transparent node OptNone<T>() returns (none: Option<T>);
let
  none = Option@<T> { some = false; value = any T };
tel

transparent function OptSome<T>(value: T) returns (some: Option<T>);
let
  some = Option@<T> { some = true; value = value };
tel

transparent function OptEq<T>(o1, o2: Option<T>) returns (res : bool)
let
  res =
    o1.some = o2.some and
    o1.some => o1.value = o2.value;
tel

function min(a: int; b: int) returns ( c: int );
let
  c = if a < b
      then a
      else b;
tel
