include "common.lus"

const N: Pos; -- Number of participants
type HostId = subtype { i : Nat | i < N };

-- {{{ Message Types

type Message = struct {
  sender: HostId;
  dest: HostId;
};

type MsgSet = bool^N^N;

const EmptySet: MsgSet = false^N^N;

function AddMsg(svm_in: MsgSet; msg: Message) returns (svm_out: MsgSet);
(* @contract
  guarantee "Message is added"
  MsgInSet(svm_out, msg);
*)
let
  svm_out[i][j] =
    if i = msg.sender and j = msg.dest then
      true
    else
      svm_in[i][j];
tel

function RemoveMsg(svm_in: MsgSet; msg: Message) returns (svm_out: MsgSet);
(* @contract
  guarantee "Message is removed"
  not MsgInSet(svm_out, msg);
*)
let
  svm_out[i][j] =
    if i = msg.sender and j = msg.dest then
      false
    else
      svm_in[i][j];
tel

function MsgInSet(svm: MsgSet; msg: Message) returns (contained: bool);
let
  contained = svm[msg.sender][msg.dest];
tel
-- }}}

-- {{{ Network
node Network(turn: HostId; send: Option<<Message>>) returns
  (recv: Option<<Message>>; inFlight: MsgSet);
(*@contract

  assume "Sends come from turn"
  send.some => send.value.sender = turn;

  assume "No one sends to self"
  send.some => send.value.dest <> send.value.sender;

  guarantee "Recv goes to turn"
  recv.some =>
    recv.value.dest = turn;

  guarantee "Recieved messages are in flight"
  recv.some => (false -> MsgInSet(pre inFlight, recv.value));

  guarantee "Recieved messages are not in flight"
  recv.some => not MsgInSet(inFlight, recv.value);

  guarantee "Sent messages are in flight"
  send.some => MsgInSet(inFlight, send.value);

  guarantee "Messages are not in flight unless sent"
  forall (msg : Message)
    (
     (true -> not MsgInSet(pre inFlight, msg)) and
     MsgInSet(inFlight, msg)
    ) =>
    (send.some and send.value = msg);

  guarantee "Messages stay in flight until recieved"
  forall (msg : Message)
    (
     (false -> MsgInSet(pre inFlight, msg)) and
     not MsgInSet(inFlight, msg)
    ) =>
    (recv.some and recv.value = msg);
*)
var prevInFlight: MsgSet;
let
  prevInFlight = EmptySet -> pre inFlight;

  recv = any {
      m: Option<<Message>> |
      m.some =>
        ( MsgInSet(prevInFlight, m.value) and
          m.value.dest = turn
        )
    };

  inFlight =
    if send.some and recv.some then
      AddMsg(RemoveMsg(prevInFlight, recv.value), send.value)
    else if send.some then
      AddMsg(prevInFlight, send.value)
    else if recv.some then
      RemoveMsg(prevInFlight, recv.value)
    else
      prevInFlight;
tel
-- }}}

-- {{{ Participant
node Participant(id: HostId; nw_recv: Option<<Message>>)
  returns (nw_send: Option<<Message>>; has_lock: bool^N);
(*@contract
  guarantee "Frame"
    true ->
      forall (i: HostId) i <> id
        => has_lock[i] = pre has_lock[i];

  guarantee "Correct Sender"
    nw_send.some =>
      nw_send.value.sender = id;

  guarantee "Send or Recv, not both"
    nw_send.some
      => not nw_recv.some;

  guarantee "Only gain lock due to recv"
    (id <> 0 -> not pre has_lock[id]) and has_lock[id]
      => nw_recv.some and nw_recv.value.dest = id;

  guarantee "Only lose lock due to send"
    (id = 0 -> pre has_lock[id]) and not has_lock[id]
      => nw_send.some;

  guarantee "Only send if we have the lock"
    nw_send.some
      => (id = 0 -> pre has_lock[id]);

  guarantee "Do not send to self"
    nw_send.some
      => nw_send.value.dest <> id;
*)
var prev_has_lock: bool^N;
var sending: bool;
var aquire: bool;
let
  prev_has_lock[i] = i = 0 -> pre has_lock[i];

  sending = (not nw_recv.some) and prev_has_lock[id] and any bool;
  aquire = nw_recv.some and nw_recv.value.dest = id;

  has_lock[i] =
    if id <> i then
      prev_has_lock[i]
    else if sending then
      false
    else if aquire then
      true
    else
      prev_has_lock[i];

  nw_send =
    if not sending then
      OptNone<<Message>>()
    else
      OptSome<<Message>>(
        Message {
          sender = id;
          dest = any { hid: HostId | hid <> id };
        }
      );
tel
-- }}}

-- {{{ System
node System()
returns (
  has_lock: bool^N;
  in_flight:
  MsgSet;
  turn: HostId;
  nw_recv: Option<<Message>>;
  nw_send: Option<<Message>>
);
(*@contract
  guarantee "Saftey"
  forall (idx, idy: HostId) has_lock[idx] and has_lock[idy] => idx = idy;

  guarantee "has lock implies not in flight"
  (exists (id: HostId) has_lock[id]) =>
    not (exists (idx, idy: HostId) in_flight[idx][idy]);

  guarantee "At most one in flight"
  forall (m1, m2: Message)
    (MsgInSet(in_flight, m1) and  MsgInSet(in_flight, m2)) =>
      m1.sender = m2.sender and
      m1.dest = m2.dest;

  guarantee "Messages sent by turn"
  nw_send.some
    => (nw_send.value.sender = turn);

  guarantee "Messages recieved by turn"
  nw_recv.some
    => (nw_recv.value.dest = turn);
*)
let
  turn = any HostId;
  nw_recv, in_flight = Network(turn, nw_send);
  nw_send, has_lock = Participant(turn, nw_recv);
tel

-- }}}

-- vim:foldmethod=marker:foldlevel=0
