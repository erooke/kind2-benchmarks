include "common.lus"

const N: Pos = 3; -- Number of participants
type HostId = subtype { i : Nat | i < N };

const MaxEpoch: subrange[2, *] of int; -- Number of epochs allowed
type Epoch = subtype { i : Nat | i < MaxEpoch };

-- {{{ Message Types

type Message = struct {
  sender: HostId;
  dest: HostId;
  epoch: Epoch;
};

node SendLock(sender: HostId; epoch: Epoch) returns (m: Message);
let
  m = Message {
    sender = sender;
    dest = any { hid: HostId | hid <> sender };
    epoch = min(epoch + 1, MaxEpoch - 1);
  };
tel

type MsgSet = bool^N^N^MaxEpoch;

const EmptySet: MsgSet = false^N^N^MaxEpoch;

function AddMsg(svm_in: MsgSet; msg: Message) returns (svm_out: MsgSet);
(*@contract
  guarantee "Message is added"
    MsgInSet(svm_out, msg);

  guarantee "Only message is added"
    forall (m: Message)
      (MsgInSet(svm_out, m) and not MsgInSet(svm_in, m))
        => m = msg;
*)
let
  svm_out[i][j][k] =
    (i = msg.epoch and j = msg.sender and k = msg.dest) or
    svm_in[i][j][k];
tel

function MsgInSet(svm: MsgSet; msg: Message) returns (contained: bool);
let
  contained = svm[msg.epoch][msg.sender][msg.dest];
tel
-- }}}

-- {{{ Network
node Network(send: Option<Message>) returns
  (recv: Option<Message>; seen_messages: MsgSet);
(*@contract
  var prev_seen_messages : MsgSet = EmptySet -> pre seen_messages;

  guarantee "Send implies seen message"
    send.some
      => MsgInSet(seen_messages, send.value);

  guarantee "Receive implies seen"
    recv.some
      => MsgInSet(seen_messages, recv.value);

  guarantee "Seen is monotonic"
    forall (m : Message)
      MsgInSet(prev_seen_messages, m)
        => MsgInSet(seen_messages, m);

  guarantee "Seen messages were sent"
    forall (msg: Message)
      MsgInSet(seen_messages, msg)
        => exists (m: history(send))
          m.some and m.value = msg;

*)
var prev_seen_messages: MsgSet;
let
  prev_seen_messages = EmptySet -> pre seen_messages;

  recv = any {
      m: Option<Message> |
      m.some => MsgInSet(prev_seen_messages, m.value)
    };

  seen_messages =
    if send.some then
      AddMsg(prev_seen_messages, send.value)
    else
      prev_seen_messages;
tel
-- }}}

-- {{{ Participant

type NodeState = struct {
  nw_send: Option<Message>;
  has_lock: bool;
  epoch: Epoch;
};

node initial_state(id: HostId) returns (r: NodeState);
let
  r = NodeState {
    nw_send = OptNone@<Message>();
    has_lock = id = 0;
    epoch =
      if id = 0
      then 1
      else 0;
  };
tel

function can_send(state: NodeState) returns (r: bool);
let
  r =
    state.has_lock and
    state.epoch < MaxEpoch - 2
    ;
tel

node relinquish(state: NodeState; hid: HostId) returns (r: NodeState);
let
  r = NodeState {
      nw_send = OptSome@<Message>(
        SendLock(hid, state.epoch)
      );
      has_lock = false;
      epoch = state.epoch;
    };
tel

node obtain(state: NodeState; epoch: Epoch) returns (r: NodeState);
let
  r = NodeState {
    nw_send = OptNone@<Message>();
    has_lock = true;
    epoch = epoch;
  };
tel

node no_send(state: NodeState) returns (r: NodeState);
let
  r = NodeState {
      nw_send = OptNone@<Message>();
      has_lock = state.has_lock;
      epoch = state.epoch;
  };
tel

node Participant(
  my_turn: bool;
  id: HostId;
  nw_recv: Option<Message>;
)
returns (
  state: NodeState;
);
(*@contract
  var prev_state : NodeState = initial_state(id) -> pre state;

  guarantee "Only send if have lock"
    state.nw_send.some
      => prev_state.has_lock;

  guarantee "Only get lock if granted"
    (not prev_state.has_lock and state.has_lock)
      => my_turn and
         nw_recv.some and
         nw_recv.value.dest = id and
         nw_recv.value.epoch > prev_state.epoch
         ;

  guarantee "Lose lock iff relinquished"
    (prev_state.has_lock and not state.has_lock)
      = state.nw_send.some
      ;
*)
var sending, acquire: bool;
var prev_state: NodeState;
let

  prev_state = initial_state(id) -> pre state;

  sending =
    my_turn and
    not acquire and
    can_send(prev_state) and
    any bool
    ;

  acquire =
    my_turn and
    nw_recv.some and                         -- We received a message
    nw_recv.value.dest = id and              -- The message is meant for us
    nw_recv.value.epoch > prev_state.epoch   -- The received message is a higher epoch
    ;

  state =
    if sending
    then relinquish(prev_state, id)
    else if acquire
    then obtain(prev_state, nw_recv.value.epoch)
    else no_send(prev_state)
    ;


tel
-- }}}

-- {{{ System
node System(turn: HostId) returns( node_states: NodeState^N )
(*@contract
  guarantee "Safety"
    forall (i, j: HostId)
      node_states[i].has_lock and
      node_states[j].has_lock
        => i = j;
*)
var seen_messages: MsgSet;
var nw_recv: Option<Message>;
let
  node_states[i] = Participant(i = turn, i, nw_recv);
  nw_recv, seen_messages = Network(node_states[turn].nw_send);

  check "At most one in flight"
    forall (m1, m2: Message)
      MsgInSet(seen_messages, m1) and
      MsgInSet(seen_messages, m2) and
      in_flight(m1, node_states) and
      in_flight(m2, node_states)
        => m1 = m2;

  check "Has lock implies none in flight"
    one_has_lock(node_states)
      => forall (m: Message)
          MsgInSet(seen_messages, m)
            => not in_flight(m, node_states);
tel
-- }}}

-- {{{ Predicates
function in_flight(m: Message; node_states: NodeState^N) returns (b: bool);
let
  b = node_states[m.dest].epoch < m.epoch;
tel

function one_has_lock(node_states: NodeState^N) returns (b: bool);
var acc: bool^N;
let
  acc[i] =
    if i = 0
    then node_states[0].has_lock
    else acc[i-1] or node_states[i].has_lock;
  b = acc[N-1];
tel
-- }}}

-- vim:foldmethod=marker:foldlevel=0
