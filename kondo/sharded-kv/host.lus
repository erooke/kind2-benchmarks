include "../common.lus"
include "types.lus"

type HostState = struct {
  nw_send: Option<Message>;
  keys: KeyMap;
};


transparent function get(state: HostState; k: Key) returns (e: Entry);
let
  e = state.keys[k];
tel

transparent function has_live_key(state: HostState; k: Key) returns (b: bool);
let
  b =
    get(state, k).is_live
    ;
tel


node initial_state() returns (h: HostState);
let
  h = HostState {
    nw_send = OptNone@<Message>();
    keys = empty_km();
  };
tel

function can_send_key(state: HostState; key: Key) returns (b: bool);
let
  b =
    has_live_key(state, key) and
    get(state, key).version + 1 < MaxVersion
    ;
tel

function imported can_send(state: HostState) returns (b: bool)
(*@contract
  guarantee "Can send iff young and live key"
    b = exists (k : Key) can_send_key(state,k) ;
*)

function valid_receive(m: Message; state: HostState) returns (b : bool)
let
  b =
    m.version > get(state, m.key).version
    ;
tel

function imported choose_key(state: HostState) returns (key : Key)
(*@contract
  guarantee
    has_live_key(state, key);
*)

function drop_key(key: Key; state: KeyMap) returns (new_state: KeyMap);
(*@contract
  guarantee
    not new_state[key].is_live and
    state[key].version = new_state[key].version
    ;

  guarantee
    forall (k: Key)
      state[k] <> new_state[k]
        => k = key
      ;
*)
let
  new_state[k] =
    if k = key
    then
      Entry {
        is_live = false;
        version = state[k].version;
      }
    else state[k];
tel

node relinquish(src: HostId; dest: HostId; state: HostState) returns (new_state : HostState)
var key: Key;
let
  key = choose_key(state);
  new_state = HostState {
    nw_send = OptSome@<Message>(
    Message {
        src = src;
        dest = dest;
        key = key;
        version = get(state, key).version + 1;
      }
    );
    keys = drop_key(key, state.keys);
  };
tel

function set_key(msg: Message; keys: KeyMap) returns (new_keys: KeyMap);
let
  new_keys[k] =
    if k = msg.key
    then Entry {is_live = true; version = msg.version;}
    else keys[k];
tel

node obtain(msg: Message; state: HostState) returns (new_state : HostState)
let
  new_state = HostState {
    nw_send = OptNone@<Message>();
    keys = set_key(msg, state.keys);
  };
tel

node no_send(state : HostState) returns (new_state: HostState);
let
  new_state = HostState{
      nw_send = OptNone@<Message>();
      keys = state.keys;
    };
tel


function imported equivalent_states(s1: HostState; s2: HostState) returns (b: bool);
(*@contract
  guarantee
    b =
      forall (k : Key) s1.keys[k] = s2.keys[k];
*)

function imported equal_states(s1: HostState; s2: HostState) returns (b: bool);
(*@contract
  guarantee
    b = equivalent_states(s1, s2) and
      forall (k : Key) s1.nw_send = s2.nw_send;
*)

-- }}}

node Host(
  my_turn: bool;
  host_id: HostId;
  prev_state: HostState;
  nw_recv: Option<Message>;
)
returns (
  state: HostState;
);
(*@contract

  assume "Prev state is well behaved"
    true -> equal_states(pre state, prev_state);

  guarantee "Frame one"
    not my_turn
      => equivalent_states(prev_state, state);

  guarantee "Frame two"
    state.nw_send.some => my_turn;

  guarantee "Monotonic state"
    forall (k : Key)
        get(prev_state, k).version <= get(state, k).version
        ;
*)
var sending, acquire, want_to_send: bool;
var dest: HostId;
let
  want_to_send = any bool;
  dest = any { hid: HostId | hid <> host_id };

  acquire =
    my_turn and
    nw_recv.some and
    nw_recv.value.dest = host_id and
    valid_receive(nw_recv.value, prev_state)
    ;

  sending =
    my_turn and
    not acquire and
    want_to_send and
    can_send(prev_state)
    ;


  state =
    if sending
    then relinquish(host_id, dest, prev_state)
    else if acquire
    then obtain(nw_recv.value, prev_state)
    else prev_state;
tel
