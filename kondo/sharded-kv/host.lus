include "../common.lus"
include "types.lus"


const N: Pos = 2; -- Number of hosts
type HostId = subtype { i : Nat | i < N };

type HostState = struct {
  nw_send: Option<Message>;
  keys: KeyMap;
};

transparent function has_key(state: HostState; k: Key) returns (b: bool);
let
  b = state.keys[k].some;
tel

transparent function get(state: HostState; k: Key) returns (e: Entry);
let
  e = state.keys[k].value;
tel

transparent function has_live_key(state: HostState; k: Key) returns (b: bool);
let
  b =
    has_key(state, k) and
    get(state, k).is_live
    ;
tel


node initial_state() returns (h: HostState);
let
  h = HostState {
    nw_send = OptNone@<Message>();
    keys = empty_km();
  };
tel

type Message = struct {
  dest: HostId;
  key: Key;
  version: Version;
};


function imported can_send(state: HostState) returns (b: bool)
(*@contract
  guarantee "Can send iff young and live key"
    b =
      exists (k : Key) has_live_key(state, k) and
      get(state, k).version + 1 < MaxVersion
      ;
*)

function valid_receive(m: Message; state: HostState) returns (b : bool)
let
  b =
    not has_key(state, m.key) or
    m.version > get(state, m.key).version
    ;
tel

function imported choose_key(state: HostState) returns (key : Key)
(*@contract
  guarantee "picks a random key"
    has_live_key(state, key);
*)

function kill_entry(entry: Option<Entry>) returns (dead_entry: Option<Entry>);
let
  dead_entry =
    if not entry.some
    then entry
    else OptSome@<Entry>(Entry {
      is_live = false;
      version = entry.value.version;
      } );
tel

function drop_key(key: Key; state: Option<Entry>^MaxKeys) returns (new_state: Option<Entry>^MaxKeys);
let
  new_state[k] =
    if k = key
    then kill_entry(state[k])
    else state[k];
tel

node relinquish(dest: HostId; state: HostState) returns (new_state : HostState)
var key: Key;
let
  key = choose_key(state);
  new_state = HostState {
    nw_send = OptSome@<Message>(
    Message {
        dest = dest;
        key = key;
        version = state.keys[key].value.version + 1;
      }
    );
    keys = drop_key(key, state.keys);
  };
tel

function set_key(msg: Message; keys: Option<Entry>^MaxKeys) returns (new_keys: Option<Entry>^MaxKeys);
let
  new_keys[k] =
    if k = msg.key
    then OptSome@<Entry>(Entry {is_live = true; version = msg.version;})
    else keys[k];
tel

node obtain(msg: Message; state: HostState) returns (new_state : HostState)
let
  new_state = HostState {
    nw_send = OptNone@<Message>();
    keys = set_key(msg, state.keys);
  };
tel

node no_send(state : HostState) returns (new_state: HostState);
let
  new_state = HostState{
      nw_send = OptNone@<Message>();
      keys = state.keys;
    };
tel


function imported equal_states(s1: HostState; s2: HostState) returns (b: bool);
(*@contract
  guarantee
    b =
      forall (k : Key) s1.keys[k] = s2.keys[k];
*)

node Host(
  my_turn: bool;
  host_id: HostId;
  nw_recv: Option<Message>;
)
returns (
  state: HostState;
);
(*@contract
  var prev_state : HostState = initial_state() -> pre state;

  guarantee "Frame one"
    not my_turn
      => equal_states(prev_state, state);

  guarantee "Frame two"
    state.nw_send.some => my_turn;

  guarantee "Monotonic state"
    forall (k : Key)
      has_key(prev_state, k) and has_key(state, k)
        =>  get(prev_state, k).version <= get(state, k).version
        ;
*)
var sending, acquire, want_to_send: bool;
var prev_state : HostState;
var dest: HostId;
let
  prev_state =  initial_state() -> pre state;
  want_to_send = any bool;
  dest = any { hid: HostId | hid <> host_id };


  acquire =
    my_turn and
    nw_recv.some and
    nw_recv.value.dest = host_id and
    valid_receive(nw_recv.value, prev_state)
    ;

  sending =
    my_turn and
    not acquire and
    want_to_send and
    can_send(prev_state)
    ;


  state =
    if sending
    then relinquish(dest, prev_state)
    else if acquire
    then obtain(nw_recv.value, prev_state)
    else prev_state;
tel
