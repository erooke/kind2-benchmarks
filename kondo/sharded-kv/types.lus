include "../common.lus"

const N: Pos = 2; -- Number of hosts
type HostId = subtype { i : Nat | i < N };

const MaxKeys: Pos = 2; -- Number of unique keys
type Key = subtype { i : Nat | i < MaxKeys };

const MaxVersion: Pos = 2; -- Number of allowed versions
type Version = subtype { i : Nat | i < MaxVersion };

type Entry = struct {
  is_live: bool;
  version: Version;
};

type KeyMap = Option<Entry>^MaxKeys;

transparent function empty_km() returns (km: KeyMap);
let
  km = Option@<Entry> {
      some = false;
      value = Entry {
        is_live = false;
        version = 0;
      };
    }^MaxKeys;
tel

type Message = struct {
  src: HostId;
  dest: HostId;
  key: Key;
  version: Version;
};

type MessageSet = bool^N^N^MaxKeys^MaxVersion;
const EmptySet : MessageSet = false^N^N^MaxKeys^MaxVersion;

function in_msg_set(svm: MessageSet; msg: Message) returns (contained: bool);
let
  contained = svm[msg.version][msg.key][msg.src][msg.dest];
tel

function imported add_msg(svm_in: MessageSet; msg: Message) returns (svm_out: MessageSet);
(*@contract
  guarantee "Message is added"
    in_msg_set(svm_out, msg);

  guarantee "The only change is the message"
    forall (m: Message)
      (in_msg_set(svm_out, m) <> in_msg_set(svm_in, m))
        => m = msg;
*)

