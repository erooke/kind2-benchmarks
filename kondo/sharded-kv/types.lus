include "../common.lus"

const MaxKeys: Pos = 2; -- Number of unique keys
type Key = subtype { i : Nat | i < MaxKeys };

const MaxVersion: Pos = 2; -- Number of allowed versions
type Version = subtype { i : Nat | i < MaxVersion };

type Entry = struct {
  is_live: bool;
  version: Version;
};

type KeyMap = Option<Entry>^MaxKeys;

transparent function empty_km() returns (km: KeyMap);
let
  km = Option@<Entry> {
      some = false;
      value = Entry {
        is_live = false;
        version = 0;
      };
    }^MaxKeys;
tel
